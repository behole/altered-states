# Copy to .env and fill in your key. Any OpenAI-compatible endpoint works.
#
# The lab is provider-agnostic: pick ONE provider block below, uncomment it,
# and paste your key. Daily volume is ~99 calls (all 10 substances) — every
# option here handles that, and the free ones cost $0.

# ---- Provider config (canonical) ----
# LLM_BASE_URL  — OpenAI-compatible base URL
# LLM_API_KEY   — API key
# LLM_MODEL     — model ID
# LLM_JSON_MODE — "native" (response_format json_object; default) or
#                 "prompt" (rely on instructions — for free models that
#                 don't accept response_format)

# --- Option A (RECOMMENDED): OpenRouter free models — $0, no card ---
# Get a key at https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-31b:free          # strong prose, good persona work
# Other free IDs (roster rotates — see openrouter.ai/models?q=:free):
#   nvidia/nemotron-3-ultra:free             # best general-purpose free
#   openai/gpt-oss-120b:free                 # strong open-weight generalist
#   deepseek/deepseek-r1:free                # reasoning — slow for journaling
# Free-tier limits: 20 req/min, 50 req/day (<$10 lifetime credits) or
# 1,000 req/day (if you've ever topped up $10 — the limit persists).
# LLM_JSON_MODE=prompt   # some free models reject response_format

# --- Option B: Groq — $0 free tier, no card, very fast, JSON mode ---
# Get a key at https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile          # 1,000 req/day free, 30 RPM
# LLM_JSON_MODE=native

# --- Option C: Google AI Studio (Gemini) free tier ---
# Get a key at https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash                 # ~250 req/day free tier
# LLM_JSON_MODE=native

# --- Option D: DeepSeek (paid fallback — ~$0.30–3/day at 99 calls) ---
# Get a key at https://platform.deepseek.com/api_keys
# Model IDs: https://platform.deepseek.com/api-docs
#   deepseek-v4-pro     — high quality (default)
#   deepseek-reasoner   — R1, slower but deeper
#   deepseek-chat       — fast, cheap (V3)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_JSON_MODE=native

# Optional: where the lab stores characters/journals/logs.
# Default is experiments/temporal-lab/runtime/ (gitignored, repo-local).
# ALTERED_STATES_TEMPORAL_PATH=~/.altered-states/temporal-lab

# Optional: dry-run mode skips real API calls and writes a deterministic
# stub response. Useful for verifying wiring without burning tokens.
# TEMPORAL_LAB_DRY_RUN=1
