# AI agent session data
.omc/
.claude/
.superpowers/
.regent/

# Superset config
.superset/

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.vscode/
.idea/

# Eval response captures (large, regenerated per model run)
tests/responses/*.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local tool session tokens
bin/.nlm-session
.env

# Built site artifact — regenerated by build.py, and kept TRACKED on purpose:
# Cloudflare Pages deploys need a committed artifact to publish. The committed
# copy is a fresh-build snapshot (~255KB); CI/cron changes to it are still
# expected and reviewed like any other file.
site/index.html

# Transient venv used by `make security` for pip-audit
.audit-venv/

# uv writes this implicitly when it runs a command in the repo; dependencies
# are pinned by the pip-compile lockfiles instead.
uv.lock

# Coverage artifacts from `make coverage`
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

# Metrics snapshots are produced by each build or lab run, not committed.
# The lab's journals and character state under
# experiments/temporal-lab/runtime/ are data and stay untracked on purpose.
runtime/
