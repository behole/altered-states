# Environment configuration
#
# The repo-root `.env` is THE project convention: copy this file there and
# the real credentials you load with `set -a && source .env && set +a`
# apply project-wide. `.env` is gitignored and never committed.
#
# Experiments that read their own `.env` are the exception, not the rule:
# `experiments/temporal-lab/.env` (see experiments/temporal-lab/.env.example)
# is still auto-loaded by the lab scripts with `override=True`, which is why
# `bin/run_eval.py` loads nothing — it takes keys straight from the
# environment sourced from the root `.env`.
#
# Nothing here is required to run the tests, the build, or any dry-run.
# Values are placeholders only — never commit a real key.

# --- model providers -------------------------------------------------------
# DeepSeek is the project's primary (and only sanctioned real-run) provider.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Legacy fallbacks. `bin/run_eval.py` is DeepSeek-only: it gates solely on
# DEEPSEEK_API_KEY and never reads these — an ambient OPENROUTER_API_KEY
# in the environment cannot silently reroute it. OpenRouter/OpenAI remain
# legacy fallbacks only for the temporal lab's explicit override surface.
ANTHROPIC_API_KEY=your-legacy-anthropic-key-here
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Music generation (experiments/music/generate.py). Required only when
# regenerating songs with that script; absent key makes the generator
# skip real calls. Existing audio in experiments/music/ is input data.
MUREKA_API_KEY=your-mureka-api-key-here

# --- temporal lab ----------------------------------------------------------
# The lab scripts (experiments/temporal-lab/scripts/, run directly with
# `python3`) read these overrides:
#   LLM_MODEL / LLM_BASE_URL / LLM_JSON_MODE — endpoint + JSON mode control.
#   LLM_API_KEY — beats OPENROUTER_API_KEY when both are set.
#   ALTERED_STATES_TEMPORAL_PATH — override per-user storage path
#     (scripts default to ~/.altered-states/temporal-lab when unset).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_JSON_MODE=native
ALTERED_STATES_TEMPORAL_PATH=
# TEMPORAL_LAB_MODEL overrides the lab's model selection for temporal_init.py;
# the main provider/model knobs for the lab are the LLM_* variables above.
TEMPORAL_LAB_MODEL=

# --- observability ---------------------------------------------------------
# Error reporting is off unless a DSN is present (excluded from the provider
# set; declared here so the skeleton is complete). Without it,
# `capture_exception` is a no-op and failures still appear as structured
# log events.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set per-deployment to tag a release when APP_RELEASE is empty; CI
# normally supplies it, so local runs can leave this untouched.
GIT_SHA=

# --- non-provider variables (excluded from the provider audit) -------------
# The following are intentionally local, CI, or infra variables and are NOT
# part of the "environment vars code reads" provider set:
#   PATH, APP_ENV, APP_RELEASE, APP_SERVICE, LOG_LEVEL, SENTRY_DSN,
#   METRICS_TEXTFILE_PATH, CF_PAGES_PROJECT, ALERT_WEBHOOK_URL,
#   TEMPORAL_LAB_DRY_RUN, FLAG_*
# They are documented here (or in experiments/temporal-lab/.env.example)
# for completeness; none of them is a credential.

# Shown in the log stream and in Sentry tags.
APP_SERVICE=altered-states
APP_ENV=development
APP_RELEASE=

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Where the Prometheus textfile snapshot is written.
METRICS_TEXTFILE_PATH=runtime/metrics/altered-states.prom

# --- feature flags ---------------------------------------------------------
# Override any flag without editing feature_flags.json:
#   FLAG_<UPPER_NAME_WITH_UNDERSCORES>=on|off
# e.g. FLAG_SITE_MUSIC_SECTION=off
FLAG_SITE_MUSIC_SECTION=
FLAG_SITE_CHAT_PERSONAS=
FLAG_SITE_EXPERIMENTS_GALLERY=
FLAG_SITE_EXPERIMENT_WHEEL=
FLAG_SITE_SUBSTANCE_PAGES=
FLAG_SITE_ARC_TIMELINE=
FLAG_SITE_DIFF_VIEW=
FLAG_SITE_QUIZ_GAME=
FLAG_SITE_JOURNAL_DASHBOARDS=
FLAG_SITE_EVAL_GRIDS=

# --- deploy / alerts -------------------------------------------------------
# Cloudflare Pages project name, used by watch.py's optional deploy step.
CF_PAGES_PROJECT=altered-states

# Optional webhook for firing alerts (the `alerts` workflow posts here).
ALERT_WEBHOOK_URL=

# --- dry-run ---------------------------------------------------------------
# Set to 1 to run lab cycles without calling a provider at all.
TEMPORAL_LAB_DRY_RUN=0
