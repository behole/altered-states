# Environment configuration
#
# Copy to `.env` and fill in what you need. `.env` is gitignored.
# Nothing here is required to run the tests, the build, or any dry-run.

# --- model providers -------------------------------------------------------
# Needed only for real (non-dry-run) model calls.
# The eval runner uses Anthropic.
ANTHROPIC_API_KEY=

# The temporal lab accepts either provider; it auto-detects the endpoint.
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Override the lab's model and base URL.
TEMPORAL_LAB_MODEL=
TEMPORAL_LAB_BASE_URL=

# Set to 1 to run lab cycles without calling a provider at all.
TEMPORAL_LAB_DRY_RUN=0

# --- observability ---------------------------------------------------------
# Error reporting is off unless a DSN is present. Without it, `capture_exception`
# is a no-op and failures still appear as structured log events.
SENTRY_DSN=

# Shown in the log stream and in Sentry tags.
APP_SERVICE=altered-states
APP_ENV=development
APP_RELEASE=

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Where the Prometheus textfile snapshot is written.
METRICS_TEXTFILE_PATH=runtime/metrics/altered-states.prom

# --- feature flags ---------------------------------------------------------
# Override any flag without editing feature_flags.json:
#   FLAG_<UPPER_NAME_WITH_UNDERSCORES>=on|off
# e.g. FLAG_SITE_MUSIC_SECTION=off
FLAG_SITE_MUSIC_SECTION=
FLAG_SITE_CHAT_PERSONAS=
FLAG_SITE_EXPERIMENTS_GALLERY=
FLAG_SITE_EXPERIMENT_WHEEL=

# --- deploy ----------------------------------------------------------------
# Cloudflare Pages project name, used by watch.py's optional deploy step.
CF_PAGES_PROJECT=altered-states

# --- alerts ----------------------------------------------------------------
# Optional webhook for firing alerts (the `alerts` workflow posts here).
ALERT_WEBHOOK_URL=
